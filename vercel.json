{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/audio-proxy",
      "destination": "/api/audio-proxy"
    },
    {
      "source": "/api/radio-proxy/(.*)",
      "destination": "/api/radio-proxy"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
